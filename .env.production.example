# Copy to .env.production (ignored by Git). Use distinct random values; never commit secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
COORDINATEC_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters

# Only for initial provisioning on a new database; remove these two lines after the first login.
COORDINATEC_BOOTSTRAP_ADMIN_USERNAME=replace-with-your-admin-username
COORDINATEC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional: only after Resend verifies correo.coordinatec.site. Leave empty to disable sending.
RESEND_API_KEY=
COORDINATEC_MAIL_FROM="CoordinaTec <bienvenida@correo.coordinatec.site>"

# Opcional: asistente de trámites del portal estudiantil (solo backend).
GROQ_API_KEY=
