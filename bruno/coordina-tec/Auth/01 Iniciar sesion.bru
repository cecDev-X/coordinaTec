meta {
  name: Iniciar sesión
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "estudiante",
    "password": "12345"
  }
}

tests {
  test("devuelve el token simulado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().rol).to.equal("ESTUDIANTE");
    expect(res.getBody().token).to.be.a("string");
  });
}
