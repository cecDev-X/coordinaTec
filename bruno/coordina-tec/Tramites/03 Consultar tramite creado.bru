meta {
  name: Consultar tipo de trámite
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/tramites/{{tramiteId}}
  body: none
  auth: inherit
}

tests {
  test("consulta el trámite creado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("tramiteId"));
  });
}
