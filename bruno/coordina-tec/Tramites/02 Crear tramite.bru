meta {
  name: Crear tipo de trámite
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/tramites
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Trámite temporal Bruno",
    "periodo": 3,
    "duracionMinutos": 20,
    "requisitos": "Solicitud de prueba",
    "activo": true,
    "prioridad": "MEDIA"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("tramiteId", res.getBody().id);
  }
}

tests {
  test("crea el trámite y guarda su id para las siguientes solicitudes", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("number");
    expect(res.getBody().nombre).to.equal("Trámite temporal Bruno");
  });
}
