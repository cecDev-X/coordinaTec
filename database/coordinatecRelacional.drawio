        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    direction LR\n\n    %% Nivel 1 a Nivel 2\n    DEPARTAMENTO ||--o{ COORDINADOR : pertenece\n\n    %% Nivel 2 a Nivel 3 (Configuración de Coordinador)\n    COORDINADOR ||--o{ HORARIO : configura\n    COORDINADOR ||--o{ BLOQUEO_CALENDARIO : registra\n\n    %% Confluencia en la Tabla Transaccional Principal (CITA)\n    COORDINADOR ||--o{ CITA : atiende\n    ESTUDIANTE ||--o{ CITA : agenda\n    FORMATO ||--o{ CITA : prerrequisito\n\n    DEPARTAMENTO {\n        int id PK\n        varchar nombre_area\n    }\n\n    COORDINADOR {\n        varchar rfc PK\n        varchar nombre_completo\n        varchar password_hash\n        int departamento_id FK\n    }\n\n    HORARIO {\n        int id PK\n        int dia_semana\n        time hora_inicio\n        time hora_salida\n        int duracion_minutos\n        varchar coordinador_rfc FK\n    }\n\n    BLOQUEO_CALENDARIO {\n        int id PK\n        date fecha_bloqueada\n        varchar motivo\n        varchar coordinador_rfc FK\n    }\n\n    ESTUDIANTE {\n        varchar numeroControl PK\n        varchar nombres\n        varchar apellidos\n        varchar carrera\n        varchar password_hash\n    }\n\n    FORMATO {\n        varchar folio PK\n        varchar asunto\n        date fecha\n        varchar tipo_tramite\n        text observaciones\n    }\n\n    CITA {\n        varchar folio PK\n        timestamp fecha_creacion\n        date fecha_programada\n        time hora_inicio\n        time hora_fin\n        varchar estado\n        varchar motivo\n        varchar coordinador_rfc FK\n        varchar estudiante_numeroControl FK\n        varchar formato_folio FK\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="l7TnC5XQz_SDeAJRglec-87">
